# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kwatmi?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Termii SMS API
# Get your API key from https://accounts.termii.com
# Cost: ~₦4 per SMS
TERMII_API_KEY="your-termii-api-key"
TERMII_SENDER_ID="Kwatmi"

# Application
NODE_ENV="development"
PORT=3000

# Tracking URL base (for SMS short links)
TRACKING_BASE_URL="https://kwatmi.ng/t"
