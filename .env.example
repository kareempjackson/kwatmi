# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kwatmi?schema=public"

# Application
NODE_ENV=development
PORT=3000

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Redis (for OTP storage and caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Termii SMS API (for OTP delivery)
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=Kwatmi
TERMII_BASE_URL=https://api.ng.termii.com/api

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=10